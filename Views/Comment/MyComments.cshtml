@model List<TurkeyCityGuide.Models.Comment>

@{
    ViewData["Title"] = "Yorumlarım";
}

<div class="container py-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-0">Yorumlarım</h2>
        <span class="badge bg-danger rounded-pill fs-6 px-3">@Model.Count Yorum</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var comment in Model)
            {
                <div class="col-12 mb-3">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h5 class="card-title fw-bold mb-1">
                                        <a asp-controller="City" asp-action="Detail" asp-route-id="@comment.City.Name" class="text-dark text-decoration-none hover-danger">
                                            @comment.City.Name
                                        </a>
                                        @if (comment.District != null)
                                        {
                                            <span class="text-muted fw-normal small"> / @comment.District.Name</span>
                                        }
                                    </h5>
                                    <div class="text-muted small">@comment.CreatedAt.ToString("dd MMMM yyyy HH:mm")</div>
                                </div>
                                <div class="text-end">
                                    <div class="mb-2">
                                        @for (int i = 0; i < 5; i++)
                                        {
                                            <i class="bi bi-star-fill @(i < comment.Rating ? "text-warning" : "text-black-50 opacity-25")" style="font-size: 0.9rem;"></i>
                                        }
                                    </div>
                                    <span class="badge @(comment.Category == "Yemek" ? "badge-food" : comment.Category == "Turistik" ? "badge-tourist" : "badge-general")">
                                        @comment.Category
                                    </span>
                                </div>
                            </div>

                            <p class="card-text text-secondary mb-3">@comment.Content</p>

                            @if (!string.IsNullOrEmpty(comment.PhotoPath))
                            {
                                <div class="mb-3">
                                    <img src="@comment.PhotoPath" class="img-fluid rounded-3 border" style="height: 100px; width: 100px; object-fit: cover;" alt="Yorum Fotoğrafı">
                                </div>
                            }

                            <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-3">
                                <a asp-controller="City" asp-action="Detail" asp-route-id="@comment.City.Name" asp-fragment="comment-@comment.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                    <i class="bi bi-eye"></i> Görüntüle
                                </a>
                                <a asp-controller="Comment" asp-action="Edit" asp-route-id="@comment.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-pencil-square"></i> Düzenle
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                <i class="bi bi-chat-dots text-secondary display-4"></i>
            </div>
            <h4 class="text-muted">Henüz hiç yorum yapmadınız.</h4>
            <p class="text-secondary mb-4">Şehirleri keşfetmeye başlayın ve deneyimlerinizi paylaşın!</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger rounded-pill px-4 fw-bold">Şehirleri Keşfet</a>
        </div>
    }
</div>
