@model IEnumerable<TurkeyCityGuide.Models.City>

<!-- Global City List Offcanvas -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasCityList" aria-labelledby="offcanvasCityListLabel">
    <div class="offcanvas-header bg-danger text-white">
        <h5 class="offcanvas-title" id="offcanvasCityListLabel">
            <i class="bi bi-geo-alt-fill me-2"></i>Şehirler
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
    </div>
    <div class="offcanvas-body p-0">
        <!-- Search within list -->
        <div class="p-3 bg-light border-bottom sticky-top">
            <input type="text" class="form-control" id="sidebarCitySearch" placeholder="Listede ara..." autocomplete="off">
        </div>

        <div class="list-group list-group-flush" id="sidebarCityListGroup">
            @foreach (var city in Model)
            {
                <a asp-controller="City" asp-action="Detail" asp-route-id="@city.Name" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center sidebar-city-item">
                    <span>
                        <span class="badge bg-secondary me-2" style="width: 25px;">@city.PlateCode.ToString("00")</span>
                        <span class="city-name">@city.Name</span>
                    </span>
                    <i class="bi bi-chevron-right small text-muted"></i>
                </a>
            }
        </div>
    </div>
</div>

<script>
    // Sidebar şehir arama - yazılan harfleri içeren şehirleri göster
    // (Navbar'daki arama mantığına benzer, ama mevcut listedeki elemanları filtreliyor)
    const sidebarSearch = document.getElementById('sidebarCitySearch');
    if (sidebarSearch) {
        const sidebarItems = document.querySelectorAll('.sidebar-city-item');

        function filterSidebarCities(term) {
            const searchTerm = term.toLowerCase().trim();

            sidebarItems.forEach(function (item) {
                const cityNameElement = item.querySelector('.city-name');
                if (!cityNameElement) return;

                const cityName = cityNameElement.textContent.toLowerCase();

                // Yazılan harfleri içeriyorsa göster, boşsa tümünü göster
                if (searchTerm === "" || cityName.includes(searchTerm)) {
                    item.style.display = ""; // Show
                } else {
                    item.style.display = "none"; // Hide
                }
            });
        }

        // Hem yazarken hem de yapıştırma / silme gibi durumlarda çalışsın
        sidebarSearch.addEventListener('input', function () {
            filterSidebarCities(this.value);
        });

        // İlk açıldığında hepsini göster
        filterSidebarCities("");
    }
</script>
