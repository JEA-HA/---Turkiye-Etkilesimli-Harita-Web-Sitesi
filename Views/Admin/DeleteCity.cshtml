@model TurkeyCityGuide.Models.City

@{
    ViewData["Title"] = "İl Sil";
}

<div class="container py-4">
    <h1>İl Sil</h1>

    <h3>Bu ili silmek istediğinizden emin misiniz?</h3>
    <div>
        <h4>@Model.Name</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Plaka Kodu</dt>
            <dd class="col-sm-10">@Model.PlateCode.ToString("00")</dd>
            <dt class="col-sm-2">Bölge</dt>
            <dd class="col-sm-10">@Model.Region</dd>
            <dt class="col-sm-2">Nüfus</dt>
            <dd class="col-sm-10">@Model.Population.ToString("N0")</dd>
        </dl>

        <form asp-action="DeleteCity" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Sil</button>
            <a asp-action="Cities" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>
