@model IEnumerable<TurkeyCityGuide.Models.City>

@{
    ViewData["Title"] = "İl Yönetimi";
}

<div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>İl Yönetimi</h1>
        <a asp-action="CreateCity" class="btn btn-danger">Yeni İl Ekle</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Plaka</th>
                <th>İl Adı</th>
                <th>Bölge</th>
                <th>Nüfus</th>
                <th>İlçe Sayısı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var city in Model)
            {
                <tr>
                    <td>@city.PlateCode.ToString("00")</td>
                    <td>@city.Name</td>
                    <td>@city.Region</td>
                    <td>@city.Population.ToString("N0")</td>
                    <td>@city.Districts.Count</td>
                    <td>
                        <a asp-action="EditCity" asp-route-id="@city.Id" class="btn btn-sm btn-outline-danger">Düzenle</a>
                        <a asp-action="DeleteCity" asp-route-id="@city.Id" class="btn btn-sm btn-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
