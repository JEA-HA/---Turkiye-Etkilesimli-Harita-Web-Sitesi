@model TurkeyCityGuide.Models.City

@{
    ViewData["Title"] = "Yeni İl Ekle";
}

<div class="container py-4">
    <h1>Yeni İl Ekle</h1>

    <form asp-action="CreateCity" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">İl Adı</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PlateCode" class="form-label">Plaka Kodu</label>
                    <input asp-for="PlateCode" class="form-control" type="number" />
                    <span asp-validation-for="PlateCode" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Region" class="form-label">Bölge</label>
                    <input asp-for="Region" class="form-control" />
                    <span asp-validation-for="Region" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Population" class="form-label">Nüfus</label>
                    <input asp-for="Population" class="form-control" type="number" />
                    <span asp-validation-for="Population" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="AreaKm2" class="form-label">Yüzölçümü (km²)</label>
                    <input asp-for="AreaKm2" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="AreaKm2" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DistrictCount" class="form-label">İlçe Sayısı</label>
                    <input asp-for="DistrictCount" class="form-control" type="number" value="0" />
                    <span asp-validation-for="DistrictCount" class="text-danger"></span>
                    <small class="form-text text-muted">SVG yüklendiğinde otomatik güncellenecektir. SVG yüklenmezse 0 olarak kalacaktır.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Elevation" class="form-label">Rakım</label>
                    <input asp-for="Elevation" class="form-control" type="number" />
                    <span asp-validation-for="Elevation" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">İlçe Harita SVG Dosyası</label>
                    <input type="file" name="districtMapSvg" class="form-control" accept=".svg" />
                    <small class="form-text text-muted">Sadece SVG formatı kabul edilir.</small>
                    @if (ViewData.ModelState["districtMapSvg"] != null && ViewData.ModelState["districtMapSvg"].Errors.Count > 0)
                    {
                        <span class="text-danger">@ViewData.ModelState["districtMapSvg"].Errors[0].ErrorMessage</span>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">Şehir Fotoğrafları</label>
                    <input type="file" name="cityPhotos" multiple class="form-control" accept="image/*" />
                    <small class="form-text text-muted">Birden fazla fotoğraf seçebilirsiniz.</small>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">Kaydet</button>
            <a asp-action="Cities" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
