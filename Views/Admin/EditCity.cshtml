@model TurkeyCityGuide.Models.City

@{
    ViewData["Title"] = "İl Düzenle";
}

<div class="container py-4">
    <h1>İl Düzenle</h1>

    <form asp-action="EditCity" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">İl Adı</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PlateCode" class="form-label">Plaka Kodu</label>
                    <input asp-for="PlateCode" class="form-control" type="number" />
                    <span asp-validation-for="PlateCode" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Region" class="form-label">Bölge</label>
                    <input asp-for="Region" class="form-control" />
                    <span asp-validation-for="Region" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Population" class="form-label">Nüfus</label>
                    <input asp-for="Population" class="form-control" type="number" />
                    <span asp-validation-for="Population" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="AreaKm2" class="form-label">Yüzölçümü (km²)</label>
                    <input asp-for="AreaKm2" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="AreaKm2" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DistrictCount" class="form-label">İlçe Sayısı</label>
                    <input asp-for="DistrictCount" class="form-control" type="number" />
                    <span asp-validation-for="DistrictCount" class="text-danger"></span>
                    <small class="form-text text-muted">SVG yüklendiğinde otomatik güncellenecektir.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Elevation" class="form-label">Rakım</label>
                    <input asp-for="Elevation" class="form-control" type="number" />
                    <span asp-validation-for="Elevation" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">İlçe Harita SVG Dosyası (Güncellemek için seçin)</label>
                    <input type="file" name="districtMapSvg" class="form-control" accept=".svg" />
                    <small class="form-text text-muted">Sadece SVG formatı kabul edilir. Mevcut dosya üzerine yazılacaktır.</small>
                    @if (ViewData.ModelState["districtMapSvg"] != null && ViewData.ModelState["districtMapSvg"].Errors.Count > 0)
                    {
                        <span class="text-danger">@ViewData.ModelState["districtMapSvg"].Errors[0].ErrorMessage</span>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">Yeni Şehir Fotoğrafları Ekle</label>
                    <input type="file" name="cityPhotos" multiple class="form-control" accept="image/*" />
                    <small class="form-text text-muted">Mevcut fotoğraflara eklenir.</small>
                </div>
            </div>
        </div>

        @if (Model.Photos != null && Model.Photos.Any())
        {
            <div class="row mb-3">
                <div class="col-12">
                    <h5>Mevcut Fotoğraflar</h5>
                    <div class="row row-cols-2 row-cols-md-4 g-3">
                        @foreach (var photo in Model.Photos)
                        {
                            <div class="col position-relative" id="photo-card-@photo.Id">
                                <div class="card h-100">
                                    <img src="@photo.ImagePath" class="card-img-top" alt="@photo.Caption" style="height: 150px; object-fit: cover;">
                                    <div class="card-body p-2 text-center">
                                        <button type="button" class="btn btn-sm btn-danger w-100" onclick="deletePhoto(@photo.Id)">
                                            <i class="bi bi-trash"></i> Sil
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="mt-3">
            <button type="submit" class="btn btn-success">Kaydet</button>
            <a asp-action="Cities" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>

<!-- Anti-Forgery Token for AJAX -->
@Html.AntiForgeryToken()

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function deletePhoto(photoId) {
            if (confirm('Bu fotoğrafı silmek istediğinize emin misiniz?')) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                // Form submit olmasın diye fetch kullanıyoruz
                const formData = new FormData();
                formData.append('id', photoId);
                formData.append('__RequestVerificationToken', token);

                fetch('/Admin/DeletePhotoAjax', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const card = document.getElementById('photo-card-' + photoId);
                        if (card) {
                            card.remove();
                        }
                    } else {
                        alert('Hata: ' + (data.message || 'Silme işlemi başarısız.'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Bir hata oluştu.');
                });
            }
        }
    </script>
}
